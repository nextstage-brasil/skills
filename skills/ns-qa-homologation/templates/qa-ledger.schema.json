{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nextstage-brasil/skills/skills/ns-qa-homologation/templates/qa-ledger.schema.json",
  "title": "QA homologation run ledger",
  "description": "Contract for qa-ledger.json written by ns-qa-homologation. One ledger per run; the verdict and the homologation score are computed from it. Validated by scripts/qa_gate.py --check-ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "run_id", "issue", "mr", "environment", "criteria", "scenarios", "findings", "residual_state", "judge_rounds"],
  "properties": {
    "ledger_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique run id, e.g. <issue-iid>-<UTC timestamp>."
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev"],
      "properties": {
        "dev": { "$ref": "#/$defs/issueRef", "description": "Development issue under homologation." },
        "qa": {
          "anyOf": [{ "$ref": "#/$defs/issueRef" }, { "type": "null" }],
          "description": "Homologation issue; null when tracker.qa_issues.mode is none."
        }
      }
    },
    "mr": {
      "description": "Merge request under homologation, or null when none exists (legal). environment.commit must equal mr.commit, or RUN_DIR/commit-ancestry.json (qa_commit_ancestry.py) must prove mr.commit is its ancestor; mr null or an unverifiable commit forces verdict Blocked (gate rule, not a schema failure).",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "commit"],
          "properties": {
            "ref": { "type": "string", "pattern": "^[^\\s!]+![0-9]+$", "description": "<project path>!<mr iid>." },
            "commit": { "$ref": "#/$defs/commit" }
          }
        },
        { "type": "null" }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "url", "health", "resets"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit", "description": "Deployed commit; must equal mr.commit." },
        "url": { "type": "string", "minLength": 1 },
        "health": { "enum": ["ok", "failed"] },
        "resets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "ENV resets used by the whole run (Q5 + Q6); cap 2 (references/failure-triage.md)."
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source", "criticality"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{1,6}$" },
          "text": { "type": "string", "minLength": 1 },
          "source": { "enum": ["issue", "derived"], "description": "derived = assumed by the agent; a derived critical AC caps the verdict at with reservations." },
          "criticality": { "enum": ["critical", "high", "medium", "low"] }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "covers", "type", "lane", "status", "attempts", "triage", "data_source", "evidence", "history"],
        "properties": {
          "id": { "type": "string", "pattern": "^S-[0-9]{1,6}$" },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^AC-[0-9]{1,6}$" }
          },
          "type": { "enum": ["positive", "negative", "business_rule", "regression"] },
          "lane": { "enum": ["runner", "browser"], "description": "runner = deterministic E2E runner; browser = exploratory browser tool." },
          "status": { "enum": ["pass", "fail", "blocked", "not_run", "flaky"] },
          "attempts": { "type": "integer", "minimum": 0, "description": "Explicit runs; equals the history length." },
          "triage": {
            "enum": ["ENV", "DATA", "TEST", "FLAKY", "PRODUCT", null],
            "description": "Failure class assigned before any retry; null when no failure occurred."
          },
          "not_run_reason": { "type": "string", "minLength": 1 },
          "blocked_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the scenario is blocked: cap exhausted, run stopped, browser tool missing, interrupted."
          },
          "data_source": { "enum": ["real", "db_fixture", "response_intercept"] },
          "mock_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why real data could not be used (data_source other than real only). Present = the judge lists the data-realism gap as not actionable."
          },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "history": {
            "type": "array",
            "items": { "$ref": "#/$defs/attempt" },
            "description": "Every explicit run in order. Replayed by the triage rules: status and triage must match the replay."
          },
          "tool": {
            "$ref": "#/$defs/browserTool",
            "description": "Browser lane only: tool used and capabilities it lacked (references/browser-tools.md)."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "pass" } } },
            "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
          },
          {
            "if": { "properties": { "status": { "const": "not_run" } } },
            "then": { "required": ["not_run_reason"] }
          },
          {
            "if": { "properties": { "status": { "const": "blocked" } } },
            "then": { "required": ["blocked_reason"] }
          },
          {
            "if": { "properties": { "lane": { "const": "browser" } } },
            "then": { "required": ["tool"] }
          },
          {
            "if": { "properties": { "lane": { "const": "runner" } } },
            "then": { "properties": { "history": { "items": { "required": ["source"] } } } }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "severity", "class", "reproduced"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{1,6}$" },
          "scenario": { "type": "string", "pattern": "^S-[0-9]{1,6}$" },
          "severity": { "enum": ["blocker", "high", "medium", "low"] },
          "class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Finding class; delivery_defect = defect in the delivered change (drives the verdict)."
          },
          "reproduced": { "type": "integer", "minimum": 1, "description": "Times reproduced in a healthy environment." }
        }
      }
    },
    "residual_state": {
      "type": "array",
      "description": "Data or resources left behind by the run; empty array = nothing left. Must always be declared.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "ref", "reason"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adherence": {
      "type": "array",
      "description": "Scenario <-> AC adherence decisions (Q7b, the only LLM judgment of the judge): one per executed scenario and covered AC. adherent false = that scenario does not count for that AC. Recorded by the agent before scripts/qa_judge.py.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "ac", "adherent", "reason"],
        "properties": {
          "scenario": { "type": "string", "pattern": "^S-[0-9]{1,6}$" },
          "ac": { "type": "string", "pattern": "^AC-[0-9]{1,6}$" },
          "adherent": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1, "description": "Why the steps and evidence do (not) show the AC behavior." }
        }
      }
    },
    "judge_rounds": {
      "type": "array",
      "description": "Homologation-score complement rounds (Q7b), appended by scripts/qa_judge.py --record-round; empty when the first score met judge.min_score.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "score_before", "score_after", "added"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "score_before": { "$ref": "#/$defs/score" },
          "score_after": { "$ref": "#/$defs/score" },
          "resume": {
            "const": true,
            "description": "Round started by a human 'continue' after the cycle ended below judge.min_score (D50); allowed after a round without score gain."
          },
          "added": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Scenario ids or gap items added in this round."
          }
        }
      }
    }
  },
  "$defs": {
    "issueRef": {
      "type": "string",
      "pattern": "^[^\\s#]+#[0-9]+$",
      "description": "<project path>#<iid>."
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "score": { "type": "number", "minimum": 0, "maximum": 10 },
    "capability": { "enum": ["navigate", "a11y_snapshot", "screenshot", "console", "network", "storage"] },
    "browserTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "missing"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Tool id from references/browser-tools.md; none = no tool available."
        },
        "missing": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "change", "health", "signals", "suggested_class"],
      "properties": {
        "outcome": { "enum": ["pass", "fail"] },
        "change": {
          "enum": ["none", "env_reset", "reseed", "spec_fix"],
          "description": "What changed before this run; must follow the previous triage action."
        },
        "health": {
          "enum": ["ok", "failed", "unknown"],
          "description": "Health re-checked after a failed run; unknown until checked."
        },
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["infra_timeout", "systemic_5xx", "precondition_missing", "data_conflict", "seed_failed", "spec_error"] },
          "description": "Objective failure signals; empty for a pass."
        },
        "suggested_class": {
          "enum": ["TEST", "PRODUCT", null],
          "description": "Agent judgment for the residue (failure without objective signal); null for a pass."
        },
        "source": {
          "type": "string",
          "pattern": "^results/[A-Za-z0-9][A-Za-z0-9._-]*\\.xml$",
          "description": "JUnit file of this run; required on runner lane (its outcome for the scenario must match), absent on browser lane."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["junit", "screenshot", "console", "network", "runner_video"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative to the run dir: junit under results/<name>.xml; other kinds evidence/S-<n>-<seq>-<slug>.<ext> (qa_evidence.py)."
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pii_scrubbed": { "type": "boolean" }
      },
      "if": { "properties": { "kind": { "const": "screenshot" } } },
      "then": { "required": ["pii_scrubbed"] }
    }
  }
}

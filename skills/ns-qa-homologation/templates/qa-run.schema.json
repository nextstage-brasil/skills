{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nextstage-brasil/skills/skills/ns-qa-homologation/templates/qa-run.schema.json",
  "title": "QA homologation run manifest (run.json)",
  "description": "Single source of run state and of every resource the run created. Q10 cleanup and 'qa-env down' act only on created_resources. Validated by scripts/qa_gate.py --check-run; cross-field rules (unique resources, run-owned ids, provider/via/kind pairing, phase and pause consistency, publication approvals, Q8 automation) live in qa_run_rules.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_version",
    "run_id",
    "issue",
    "level",
    "profile_sha256",
    "environment",
    "phase",
    "phases",
    "created_resources",
    "checkpoints",
    "pauses"
  ],
  "properties": {
    "run_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]{8}T[0-9]{4}Z$",
      "description": "<dev issue iid>-<UTC YYYYMMDDTHHMMZ>."
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "qa"
      ],
      "properties": {
        "dev": {
          "$ref": "#/$defs/issueRef"
        },
        "qa": {
          "anyOf": [
            {
              "$ref": "#/$defs/issueRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "effective",
        "caps"
      ],
      "properties": {
        "declared": {
          "$ref": "#/$defs/level"
        },
        "effective": {
          "$ref": "#/$defs/level"
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "autonomy_caps reasons from qa_gate.py --check-profile."
        }
      }
    },
    "profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "enum": [
            "script",
            "url",
            "none"
          ],
          "description": "Profile environment.provider at Q0."
        }
      }
    },
    "phase": {
      "anyOf": [
        {
          "$ref": "#/$defs/phaseId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last phase whose exit gate passed; null before Q0 passes. Resume starts at the next phase."
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "state",
          "updated_at"
        ],
        "properties": {
          "phase": {
            "$ref": "#/$defs/phaseId"
          },
          "state": {
            "enum": [
              "running",
              "passed",
              "failed",
              "skipped"
            ]
          },
          "updated_at": {
            "$ref": "#/$defs/timestamp"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_resources": {
      "type": "array",
      "description": "Every resource this run created, appended at creation time. Nothing else is ever removed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "created_at",
          "created_by_phase",
          "via"
        ],
        "properties": {
          "kind": {
            "enum": [
              "container",
              "volume",
              "database",
              "image",
              "worktree",
              "evidence_dir"
            ]
          },
          "id": {
            "$ref": "#/$defs/resourceId"
          },
          "created_at": {
            "$ref": "#/$defs/timestamp"
          },
          "created_by_phase": {
            "$ref": "#/$defs/phaseId"
          },
          "via": {
            "enum": [
              "qa-env",
              "agent"
            ],
            "description": "Who removes it: qa-env = 'qa-env down'; agent = the agent itself (worktree, evidence_dir)."
          },
          "repo_root": {
            "$ref": "#/$defs/repoPath",
            "description": "kind worktree only: repo the worktree belongs to, relative to the project root; id is relative to it. Agent worktree removal = git -C <repo_root> worktree remove <id> (never --force); absent = kept."
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "description": "One entry per execution.budget.checkpoint_min window reached, in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window",
          "at",
          "decision"
        ],
        "properties": {
          "window": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "decision": {
            "enum": [
              "pending",
              "continue",
              "stop"
            ]
          }
        }
      }
    },
    "pauses": {
      "type": "array",
      "description": "Every wait on the human. resolved_at and answer are null while waiting; at most one open pause.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "phase",
          "reason",
          "resolved_at",
          "answer"
        ],
        "properties": {
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "phase": {
            "$ref": "#/$defs/phaseId"
          },
          "reason": {
            "enum": [
              "checkpoint",
              "stall",
              "below_min_score",
              "preview_approval"
            ]
          },
          "resolved_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "answer": {
            "enum": [
              "continue",
              "stop",
              "publish_anyway",
              "approve",
              "adjust",
              "do_not_publish",
              null
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "What was asked: phase, what was tried, what is needed (stall); window summary (checkpoint)."
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvals",
        "outcome"
      ],
      "description": "Q9 (effective >= L2): one approval per answered preview_approval pause, in order (scripts/qa_publish_plan.py approval), then the publication outcome (qa_publish_plan.py record).",
      "properties": {
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "answer",
              "preview_sha256",
              "at"
            ],
            "properties": {
              "answer": {
                "enum": [
                  "approve",
                  "adjust",
                  "do_not_publish"
                ]
              },
              "preview_sha256": {
                "$ref": "#/$defs/sha256",
                "description": "sha256 of the preview.md the human answered."
              },
              "at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "outcome": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "evidence_upload",
                "at"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "published",
                    "offline"
                  ],
                  "description": "offline = MCP unavailable; publish-payload.md written; nothing posted."
                },
                "evidence_upload": {
                  "enum": [
                    "complete",
                    "partial",
                    "not_needed",
                    "none"
                  ],
                  "description": "partial = an upload failed; remaining captures kept locally. not_needed = no attachment. none = offline."
                },
                "at": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "excluded",
        "skip_reason",
        "branch",
        "specs",
        "runs",
        "reviews",
        "subject",
        "commit_specs_sha256",
        "commit",
        "pushed",
        "mr"
      ],
      "description": "Q8 (effective L3 only), written by scripts/qa_automation.py: selected scenarios or the no-op skip reason, E2E branch, spec set, stability runs, review rounds, commit, push, MR (references/automation-handoff.md).",
      "properties": {
        "scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S-[0-9]{1,6}$"
          },
          "description": "plan automate: true, runner lane, no existing coverage, ledger pass."
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "reason"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "pattern": "^S-[0-9]{1,6}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Non-null = nothing to automate: Q8 skipped (justified no-op)."
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/branch"
            },
            {
              "type": "null"
            }
          ]
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repoPath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "description": "Spec files relative to the E2E worktree (last declared set)."
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "sha256",
              "specs_sha256",
              "green",
              "outcomes",
              "at"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^automation/[A-Za-z0-9][A-Za-z0-9._-]*\\.xml$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256",
                "description": "sha256 of the report with all whitespace removed: a re-recorded report (same content, other path or spacing) is refused."
              },
              "specs_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "green": {
                "type": "boolean"
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "scenario",
                    "outcome"
                  ],
                  "properties": {
                    "scenario": {
                      "type": "string",
                      "pattern": "^S-[0-9]{1,6}$"
                    },
                    "outcome": {
                      "enum": [
                        "pass",
                        "fail",
                        "skipped",
                        "missing"
                      ]
                    }
                  }
                },
                "description": "One entry per automated scenario, in automation.scenarios order (missing = no test case mapped)."
              },
              "at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "reviewer",
              "verdict",
              "score",
              "lint_findings",
              "lint_rules",
              "lint_config_sha256",
              "specs_sha256",
              "at"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "Approved",
                  "Rejected",
                  "Blocked"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "lint_findings": {
                "type": "integer",
                "minimum": 0
              },
              "lint_rules": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z-]*$"
                },
                "description": "Lint rule ids enforced in this round (repo config may disable some); disclosed in the MR description."
              },
              "lint_config_sha256": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "E2E repo checkout .e2e-antipatterns.json sha256 used by lint; null = built-in rules."
              },
              "specs_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "subject": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Commit subject (E2E repo commit_language) after commit_prefix; MR title = prefix + subject."
        },
        "commit_specs_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Spec set the printed commit argv covers (set by commit, cleared by specs); record-commit requires the current set."
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pushed": {
          "type": "boolean"
        },
        "mr": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "iid",
                "url"
              ],
              "properties": {
                "iid": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "issueRef": {
      "type": "string",
      "pattern": "^[^\\s#]+#[0-9]+$"
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "phaseId": {
      "enum": [
        "Q0",
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "Q5",
        "Q6",
        "Q7",
        "Q7b",
        "Q8",
        "Q9",
        "Q10"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9.][A-Za-z0-9._/:@+-]*$",
      "description": "Name or repo-relative path. Safe for command arguments: starts alphanumeric or '.' (never '-'), only [A-Za-z0-9._/:@+-], no '..'. Must embed the run_id (boundary-aware)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9.][A-Za-z0-9._/@+-]*$",
      "description": "Relative path safe for command arguments: starts alphanumeric or '.', only [A-Za-z0-9._/@+-], no '..'."
    },
    "branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "description": "E2E branch; full rules in qa_automation_rules.branch_problem."
    }
  }
}

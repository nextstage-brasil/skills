-- Snippet: entity-edge-schema.sql — surviving identity, logical edge, evidence, mention
-- Illustrative. Vector similarity must not INSERT into edge.
-- Provenance detail lives on evidence, mention, and document_relation — not inline jsonb on edge.

CREATE TABLE entity (
  id                bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  entity_type       text NOT NULL,
  canonical_key     text NOT NULL,
  description       text NOT NULL DEFAULT '',
  confidence        real NOT NULL CHECK (confidence >= 0 AND confidence <= 1),
  embedding         vector(1536),
  embedding_version text,
  UNIQUE (entity_type, canonical_key)
);

CREATE TABLE entity_alias (
  id            bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  entity_id     bigint NOT NULL REFERENCES entity (id),
  alias_key     text NOT NULL,
  source        text NOT NULL,
  UNIQUE (alias_key, source)
);

CREATE TABLE edge (
  id                bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  edge_type         text NOT NULL,
  from_id           bigint NOT NULL REFERENCES entity (id),
  to_id             bigint NOT NULL REFERENCES entity (id),
  provenance_class  text NOT NULL CHECK (provenance_class IN ('EXPLICIT', 'INFERRED')),
  review_status     text NOT NULL
                    CHECK (review_status IN ('fact', 'pending_review', 'proposal')),
  confidence        real NOT NULL CHECK (confidence >= 0 AND confidence <= 1),
  valid_from        date,
  valid_to          date,
  created_at        timestamptz NOT NULL DEFAULT now(),
  CHECK (from_id <> to_id),
  UNIQUE (from_id, edge_type, to_id)
);

CREATE TABLE evidence (
  id            bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  edge_id       bigint NOT NULL REFERENCES edge (id),
  document_id   bigint NOT NULL REFERENCES document (id),
  unit_id       bigint NOT NULL REFERENCES chunk (id),
  quoted_text   text NOT NULL,
  confidence    real NOT NULL CHECK (confidence >= 0 AND confidence <= 1),
  created_at    timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE mention (
  id               bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  unit_id          bigint NOT NULL REFERENCES chunk (id),
  entity_id        bigint NOT NULL REFERENCES entity (id),
  role_in_context  text NOT NULL,
  confidence       real NOT NULL CHECK (confidence >= 0 AND confidence <= 1),
  UNIQUE (unit_id, entity_id, role_in_context)
);

CREATE TABLE document_relation (
  id                 bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  from_document_id   bigint NOT NULL REFERENCES document (id),
  to_document_id     bigint NOT NULL REFERENCES document (id),
  relation_type      text NOT NULL,
  provenance_class   text NOT NULL CHECK (provenance_class IN ('EXPLICIT', 'INFERRED')),
  source_unit_id     bigint REFERENCES chunk (id),
  quoted_text        text,
  confidence         real NOT NULL CHECK (confidence >= 0 AND confidence <= 1),
  created_at         timestamptz NOT NULL DEFAULT now(),
  CHECK (from_document_id <> to_document_id),
  UNIQUE (from_document_id, to_document_id, relation_type)
);

CREATE INDEX edge_from_type_idx ON edge (from_id, edge_type) WHERE review_status = 'fact';
CREATE INDEX edge_to_type_idx ON edge (to_id, edge_type) WHERE review_status = 'fact';
CREATE INDEX edge_valid_period_idx ON edge (valid_from, valid_to);
CREATE INDEX evidence_edge_id_idx ON evidence (edge_id);
CREATE INDEX evidence_document_id_idx ON evidence (document_id);
CREATE INDEX evidence_unit_id_idx ON evidence (unit_id);
CREATE INDEX mention_unit_id_idx ON mention (unit_id);
CREATE INDEX mention_entity_id_idx ON mention (entity_id);
CREATE INDEX document_relation_from_idx ON document_relation (from_document_id);
CREATE INDEX document_relation_to_idx ON document_relation (to_document_id);

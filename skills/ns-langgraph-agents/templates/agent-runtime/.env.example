# LLM — main profile (reasoning, extraction, offer)
# @env LLM_PROVIDER — lmstudio | openai | openrouter (base URL comes from provider preset)
LLM_PROVIDER=lmstudio
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio
# LLM_TEMPERATURE=0.3

# LLM — light profile (used for context summarization, and optionally light copy tasks)
# If unset, every step uses the main profile above.
# LLM_LIGHT_PROVIDER=openai
# LLM_LIGHT_MODEL=gpt-4o-mini
# LLM_LIGHT_API_KEY=
# LLM_LIGHT_TEMPERATURE=0.2

# @env CONTEXT_MAX_TOKENS — token budget for conversation history sent to the LLM (default 12000; ~80000 recommended in production with Sonnet 5)
CONTEXT_MAX_TOKENS=12000
# @env CONTEXT_SUMMARIZE_MULTIPLIER — trigger summarization when history exceeds CONTEXT_MAX_TOKENS * this value (default 2)
CONTEXT_SUMMARIZE_MULTIPLIER=2
# @env CONTEXT_TOOL_OUTPUT_MAX_CHARS — max chars of MCP/tool output kept in conversation state (default 4000)
CONTEXT_TOOL_OUTPUT_MAX_CHARS=4000
# @env CONTEXT_SKILL_BODY_MAX_CHARS — max chars of skill procedure body (default 16000; MUST differ from tool wire cap)
CONTEXT_SKILL_BODY_MAX_CHARS=16000

# Tool budgets per turn (gather / ReAct bounded)
# SoT names = rules-contract / tool-budget: AGENT_MAX_TOOL_CALLS (8), AGENT_MAX_MCP_CALLS (6)
# @env AGENT_MAX_TOOL_CALLS — all tool kinds (default 8)
AGENT_MAX_TOOL_CALLS=8
# @env AGENT_MAX_MCP_CALLS — MCP calls only (default 6)
AGENT_MAX_MCP_CALLS=6
# MAX_*_PER_TURN retired — ignored if set
# @env TURN_LATENCY_BUDGET_MS — wall-clock abort for graph.invoke (default 60000)
# TURN_LATENCY_BUDGET_MS=60000
# @env AGENT_MAX_COST_PER_TURN — reserved spend abort before next LLM/tool (product-set; rules-contract max_cost_per_turn)
# AGENT_MAX_COST_PER_TURN=

# PostgreSQL — required. Observability, memory, RAG and LangGraph checkpointer.
DATABASE_URL=postgresql://user:pass@localhost:5432/{{PRODUCT_SLUG}}_agent
CHECKPOINTER=postgres

# Agent HTTP (npm start)
PORT=3100

# Dev chat — manual test page at GET /dev-chat.
# Local default: enable for human train/test. NEVER set true in production.
DEV_CHAT_ENABLED=true
# @env DEV_CHAT_SHOW_PROGRESS — show Pensando… / Obtendo dados… (default true)
# DEV_CHAT_SHOW_PROGRESS=false

# LangSmith — opt-in (observability default is PostgreSQL)
# LANGSMITH_ENABLED=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT={{PRODUCT_SLUG}}

# OpenTelemetry GenAI — opt-in (Postgres remains SoT)
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME={{PRODUCT_SLUG}}-agent-api
# OTEL_CONTENT_CAPTURE=false

# Skills directory (default: ./skills under agent-api)
# SKILLS_DIR=skills

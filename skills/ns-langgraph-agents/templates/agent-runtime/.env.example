# LLM — any provider on any stage (lmstudio | openai | openrouter | vllm)
# @env LLM_PROVIDER — default provider
# @env LLM_BASE_URL — optional override of provider preset (required for vllm)
# @env LLM_REASONING — none|low|medium|high (openai/openrouter map effort; lmstudio/vllm ignore)
LLM_PROVIDER=lmstudio
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio
# LLM_TEMPERATURE=0.3
# LLM_BASE_URL=
# LLM_REASONING=none

# Mixed stage example — summarize on one provider, composer/analyst on another:
# LLM_SUMMARIZE_PROVIDER=lmstudio
# LLM_SUMMARIZE_MODEL=google/gemma-4-e4b
# LLM_COMPOSER_PROVIDER=openai
# LLM_COMPOSER_MODEL=gpt-4o-mini
# LLM_COMPOSER_API_KEY=
# LLM_ANALYST_PROVIDER=vllm
# LLM_ANALYST_BASE_URL=http://127.0.0.1:8000/v1
# LLM_ANALYST_MODEL=local-model
# In Docker, host LLM URLs become host.docker.internal

# LLM — light profile (context summarization). Unset → main profile.
# LLM_LIGHT_PROVIDER=openai
# LLM_LIGHT_MODEL=gpt-4o-mini
# LLM_LIGHT_API_KEY=
# LLM_LIGHT_TEMPERATURE=0.2
# LLM_LIGHT_BASE_URL=
# LLM_LIGHT_REASONING=

# @env CONTEXT_MAX_TOKENS — model raw context window (default 12000). Summarize ratios are code constants: trigger 80%, compact to 50%, summary cap 10%.
CONTEXT_MAX_TOKENS=12000
# @env CONTEXT_TOOL_OUTPUT_MAX_CHARS — max chars MCP/tool output in state (default 4000)
CONTEXT_TOOL_OUTPUT_MAX_CHARS=4000
# @env CONTEXT_SKILL_BODY_MAX_CHARS — max chars skill body (default 16000; MUST differ from tool wire)
CONTEXT_SKILL_BODY_MAX_CHARS=16000

# Tool budgets per turn
# SoT names = rules-contract / tool-budget: AGENT_MAX_TOOL_CALLS (8), AGENT_MAX_MCP_CALLS (6)
# @env AGENT_MAX_TOOL_CALLS — all tool kinds (default 8)
AGENT_MAX_TOOL_CALLS=8
# @env AGENT_MAX_MCP_CALLS — MCP calls only (default 6)
AGENT_MAX_MCP_CALLS=6
# @env AGENT_MAX_ANALYST_ITERATIONS — analyst hops per turn (default 3)
AGENT_MAX_ANALYST_ITERATIONS=3
# MAX_*_PER_TURN retired — ignored if set
# @env TURN_LATENCY_BUDGET_MS — wall-clock abort for graph stream/invoke (default 60000)
# TURN_LATENCY_BUDGET_MS=60000
# @env AGENT_MAX_COST_PER_TURN — reserved spend abort before next LLM/tool (product-set; rules-contract max_cost_per_turn)
# AGENT_MAX_COST_PER_TURN=

# PostgreSQL — required. Observability, memory, RAG and LangGraph checkpointer.
DATABASE_URL=postgresql://user:pass@localhost:5432/{{PRODUCT_SLUG}}_agent
CHECKPOINTER=postgres

# Agent HTTP (npm start)
PORT=3100

# Dev chat — GET /dev-chat (styled React bench). NEVER true in production.
DEV_CHAT_ENABLED=true
# @env DEV_CHAT_SHOW_PROGRESS — show status slot (default true)
# DEV_CHAT_SHOW_PROGRESS=false
# @env DEV_CHAT_INITIAL_MESSAGE — composer prefill; unset → Good morning; empty → blank
DEV_CHAT_INITIAL_MESSAGE=Good morning

# LangSmith — opt-in
# LANGSMITH_ENABLED=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT={{PRODUCT_SLUG}}

# OpenTelemetry GenAI — opt-in
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME={{PRODUCT_SLUG}}-agent-api
# OTEL_CONTENT_CAPTURE=false

# Skills directory (default: ./skills under agent-api)
# SKILLS_DIR=skills

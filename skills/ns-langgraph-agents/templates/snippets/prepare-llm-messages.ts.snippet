// Snippet: prepare-llm-messages.ts — context_manager helper
import type { BaseMessage } from "@langchain/core/messages";
import type { BaseLanguageModel } from "@langchain/core/language_models/base";
import {
  resolveContextConfig,
  trimMessagesForLlm,
  truncateToolOutput,
} from "./context-window";

/**
 * context_manager pipeline: prune → compress discovery tools → trim → optional summarize.
 * Placeholder: summarize branch not implemented — extend before production use.
 * Run before analyst on MCP-heavy graphs. Emit SSE `thinking` only when summarize runs.
 */
export async function prepareLlmMessages(
  messages: BaseMessage[],
  model: BaseLanguageModel,
  options?: { pruneDiscovery?: boolean },
): Promise<BaseMessage[]> {
  const config = resolveContextConfig();
  const pruned = options?.pruneDiscovery
    ? compressDiscoveryToolMessages(messages)
    : messages;
  const trimmed = await trimMessagesForLlm(
    pruned,
    config.maxTokens,
    model,
  );
  return trimmed;
}

/** Replace bulky intra-turn discovery ToolMessages with short notes after analytical evidence exists. */
export function compressDiscoveryToolMessages(
  messages: BaseMessage[],
): BaseMessage[] {
  // Product-specific: mark discovery-only tools; keep last N analytical ToolMessages full.
  return messages;
}

export { truncateToolOutput };

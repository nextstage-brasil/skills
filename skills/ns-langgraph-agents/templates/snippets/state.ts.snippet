// Snippet: state.ts — minimal AgentState
import { Annotation, messagesStateReducer } from "@langchain/langgraph";
import type { BaseMessage } from "@langchain/core/messages";

export const AgentState = Annotation.Root({
  messages: Annotation<BaseMessage[]>({
    reducer: messagesStateReducer,
    default: () => [],
  }),
  // Node id MUST differ from channel key — e.g. addNode("analyst") writes { analysis, executionPlan }
  // plan_execute — uncomment when graph-spec declares:
  // guardRoute: Annotation<"agent" | "respond" | null>({ default: () => null }),
  // summary: Annotation<string | null>({ default: () => null }),
  // mcpCatalog: Annotation<{ tools: { name: string; description: string }[]; catalogVersion: string } | null>({ default: () => null }),
  // analysis: Annotation<{ intent?: string; userFacingIntent?: string } | null>({ default: () => null }),
  // executionPlan: Annotation<{ status: string; actions: unknown[] } | null>({ default: () => null }),
  // executionResults: Annotation<unknown[]>({ default: () => [] }),
  // analystStatus: Annotation<"need_more_data" | "complete" | "clarification_required" | null>({ default: () => null }),
  // dataBundle: Annotation<Record<string, unknown> | null>({ default: () => null }),
  // discoveryBrief: Annotation<{ found: string[]; absent: string[] } | null>({ default: () => null }),
  // externalError: Annotation<{ code: string; message: string } | null>({ default: () => null }),
  // turnDecisions: Annotation<Record<string, unknown>[]>({ default: () => [] }),
  // turnLocale: Annotation<string | null>({ default: () => null }),
  // currencyHint: Annotation<string | null>({ default: () => null }),
});

export type AgentStateType = typeof AgentState.State;

// Snippet: tool-budget.ts — per-turn tool/MCP budgets and duplicate-skip
// Cost stop is separate: AGENT_MAX_COST_PER_TURN / max_cost_per_turn — rules-contract.md + error-and-reliability.md
import { createHash } from "node:crypto";

export type ToolBudgetConfig = {
  maxToolCallsPerTurn: number;
  maxMcpCallsPerTurn: number;
};

function readPreferredEnv(key: string, fallback: number): number {
  const n = Number(process.env[key]);
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

export function resolveMaxToolCallsPerTurn(): number {
  return readPreferredEnv("AGENT_MAX_TOOL_CALLS", 8);
}

export function resolveMaxMcpCallsPerTurn(): number {
  return readPreferredEnv("AGENT_MAX_MCP_CALLS", 6);
}

export function resolveToolBudgetConfig(): ToolBudgetConfig {
  return {
    maxToolCallsPerTurn: resolveMaxToolCallsPerTurn(),
    maxMcpCallsPerTurn: resolveMaxMcpCallsPerTurn(),
  };
}

/** Stable fingerprint for duplicate detection — redact secrets before hashing. */
export function toolArgFingerprint(toolName: string, args: unknown): string {
  const payload = JSON.stringify({ toolName, args });
  return createHash("sha256").update(payload).digest("hex").slice(0, 16);
}

/**
 * Skip when same tool+args already ran this turn.
 * Break gather loop when entire round is duplicates AND evidence already in state.
 */
export function shouldSkipDuplicateCall(
  fingerprint: string,
  seenThisTurn: Set<string>,
): boolean {
  return seenThisTurn.has(fingerprint);
}

export function recordCallFingerprint(
  fingerprint: string,
  seenThisTurn: Set<string>,
): void {
  seenThisTurn.add(fingerprint);
}

export function isBudgetExceeded(
  toolCalls: number,
  mcpCalls: number,
  config: ToolBudgetConfig,
): boolean {
  return (
    toolCalls >= config.maxToolCallsPerTurn ||
    mcpCalls >= config.maxMcpCallsPerTurn
  );
}

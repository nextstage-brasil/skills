// Snippet: context-window.ts — trim and truncate helpers
import { trimMessages, type BaseMessage } from "@langchain/core/messages";
import type { BaseLanguageModel } from "@langchain/core/language_models/base";

export const SUMMARIZE_AT_RATIO = 0.8;
export const COMPACT_TO_RATIO = 0.5;
export const SUMMARY_MAX_RATIO = 0.1;

export type ContextConfig = {
  maxTokens: number;
  toolOutputMaxChars: number;
  skillBodyMaxChars: number;
};

export function resolveContextConfig(): ContextConfig {
  const n = (key: string, fallback: number) => {
    const v = Number(process.env[key]);
    return Number.isFinite(v) && v > 0 ? v : fallback;
  };
  return {
    maxTokens: n("CONTEXT_MAX_TOKENS", 12000),
    toolOutputMaxChars: n("CONTEXT_TOOL_OUTPUT_MAX_CHARS", 4000),
    skillBodyMaxChars: n("CONTEXT_SKILL_BODY_MAX_CHARS", 12000),
  };
}

/** Extract LLM-visible text from MCP wire shape before truncate — avoids double-stringify cuts. */
export function normalizeMcpToolResult(raw: unknown): string {
  if (typeof raw === "string") return raw;
  if (raw && typeof raw === "object") {
    const o = raw as Record<string, unknown>;
    if (typeof o.content === "string") return o.content;
    if (Array.isArray(o.content)) {
      return o.content
        .map((block) =>
          block && typeof block === "object" && "text" in block
            ? String((block as { text: unknown }).text)
            : "",
        )
        .filter(Boolean)
        .join("\n");
    }
    if (o.structuredContent != null) {
      return JSON.stringify(o.structuredContent);
    }
  }
  return JSON.stringify(raw);
}

export function truncateSkillBody(body: string, maxChars: number): string {
  return truncateToolOutput(body, maxChars);
}

export async function trimMessagesForLlm(
  messages: BaseMessage[],
  maxTokens: number,
  model: BaseLanguageModel,
): Promise<BaseMessage[]> {
  const trimmed = await trimMessages(messages, {
    maxTokens,
    tokenCounter: model,
    strategy: "last",
    startOn: "human",
    includeSystem: true,
  });
  if (trimmed.some((m) => m._getType() === "human")) return trimmed;
  const lastHuman = messages.map((m) => m._getType()).lastIndexOf("human");
  return lastHuman === -1 ? trimmed : messages.slice(lastHuman);
}

export function truncateToolOutput(output: string, maxChars: number): string {
  if (output.length <= maxChars) return output;
  return `${output.slice(0, maxChars)}\n…[truncated ${output.length - maxChars} chars]`;
}

export function shouldSummarize(usedTokens: number, window: number): boolean {
  return usedTokens > window * SUMMARIZE_AT_RATIO;
}

export function compactTargetTokens(window: number): number {
  return Math.floor(window * COMPACT_TO_RATIO);
}

export function summaryMaxTokens(window: number): number {
  return Math.floor(window * SUMMARY_MAX_RATIO);
}

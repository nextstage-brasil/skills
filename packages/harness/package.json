{
  "name": "@nextstage-brasil/harness",
  "version": "1.6.1",
  "description": "Interactive CLI to install NextStage skills and scaffold SDD project layout",
  "type": "module",
  "bin": {
    "harness": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "scripts",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/cli.js list --presets && node bin/cli.js validate && node bin/cli.js --dry-run --yes --preset gitlab && node bin/cli.js --dry-run --yes --preset spec-driven && node test/sync-smoke.mjs && node test/export-external.mjs",
    "export:external": "node scripts/build-external.mjs",
    "validate:external": "node scripts/validate-external.js",
    "generate:coder-routing-doc": "node scripts/generate-coder-skill-routing-doc.mjs",
    "export:coder-routing-mermaid": "node scripts/export-code-routing-mermaid.mjs"
  },
  "keywords": [
    "nextstage",
    "skills",
    "harness",
    "sdd",
    "agent-skills"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextstage-brasil/skills.git",
    "directory": "packages/harness"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1"
  }
}
